<resources>
    <style name="Base.Theme.JDEnglish" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/jd_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/jd_red_light</item>
        <item name="colorOnPrimaryContainer">@color/jd_red_dark</item>
        <item name="colorSecondary">@color/jd_red</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/jd_red_light</item>
        <item name="colorOnSecondaryContainer">@color/jd_red_dark</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorAccent">@color/jd_red</item>
        <item name="colorControlActivated">@color/jd_red</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="toolbarStyle">@style/Widget.JDEnglish.Toolbar</item>
    </style>

    <style name="Theme.JDEnglish" parent="Base.Theme.JDEnglish" />

    <style name="Widget.JDEnglish.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextAppearance">@style/TextAppearance.JDEnglish.ToolbarTitle</item>
        <item name="titleCentered">false</item>
    </style>

    <style name="TextAppearance.JDEnglish.ToolbarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.JDEnglish.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.JDEnglish.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.JDEnglish.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/jd_red_light</item>
    </style>
</resources>
