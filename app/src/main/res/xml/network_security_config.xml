<?xml version="1.0" encoding="utf-8"?>
<!-- JD still serves some legacy http:// resources (old images, redirects); the WebView
     upgrades/handles mixed content itself. Only system CAs are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
